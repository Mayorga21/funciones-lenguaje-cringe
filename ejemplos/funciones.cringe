// Hechizos (funciones) en Cringe
// Un hechizo se declara con: hechizo nombre(ingredientes) lanza tipo { cuerpo }
// 'lanza vacio' significa que el hechizo no devuelve valor.

// Procedimiento: recibe un pergamino y lo narra
hechizo saludar(pergamino quien) lanza vacio {
    narro quien uwu
}

// Devuelve un numerito como flotadito (evolucion implicita en 'regreso')
hechizo comoFlotante(numerito n) lanza flotadito {
    regreso n uwu
}

// Un hechizo puede lanzar otros declarados antes y tener variables locales
hechizo presentar(pergamino nombre, numerito edad) lanza numerito {
    invoco pergamino saludo diay "Hola" uwu
    narro saludo uwu
    saludar(nombre) uwu
    narro edad uwu
    regreso edad uwu
}

invoco pergamino quien diay "Ana" uwu
invoco numerito anios diay presentar(quien, 20) uwu
invoco flotadito f diay comoFlotante(anios) uwu
narro f uwu
saludar("fin del programa") uwu
